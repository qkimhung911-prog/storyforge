    {
      "parameters": {
        "jsCode": "const jobs = $('Ghép bản dịch').all();\nreturn $input.all().map((it, i) => {\n  const img = it.json.result ? it.json.result.image : it.json.image;\n  const j = jobs[i].json;\n  if (!img) throw new Error('Cloudflare không trả ảnh cho shot ' + j.slug + ': ' + JSON.stringify(it.json).slice(0, 300));\n  return { json: { shot_id: j.shot_id, slug: j.slug, version: j.version, prompt: j.prompt, name: `${j.slug}-v${j.version}`, data: img } };\n});"
      },
      "id": "c0000013-0000-4000-8000-000000000013",
      "name": "Lấy ảnh",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
