    {
      "parameters": {
        "method": "POST",
        "url": "=https://dlmboivixwjpjlmzfvuz.supabase.co/rest/v1/rpc/{{ $('Nhận project').first().json.body.shot_slug ? 'get_shot_job' : 'get_keyframe_jobs' }}",
        "authentication": "predefinedCredentialType",
