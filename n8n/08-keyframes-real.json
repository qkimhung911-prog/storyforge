        "jsonBody": "={{ JSON.stringify($('Nhận project').first().json.body.shot_slug ? { pid: $('Nhận project').first().json.body.project_id, shot_slug: $('Nhận project').first().json.body.shot_slug } : { pid: $('Nhận project').first().json.body.project_id }) }}",
