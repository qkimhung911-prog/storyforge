      "id": "c0000004-0000-4000-8000-000000000004",
      "name": "Lấy danh sách shot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const j = item.json;\n  const loc = j.location || {};\n  const chars = (j.characters || []).map(c => {\n    const acc = (c.accessories || []).join(', ');\n    return `${c.name} (${c.gender}, ${c.age} tuổi, ${c.appearance}, ${c.outfit}${acc ? ', ' + acc : ''})`;\n  }).join('; ');\n  const prompt = `Góc máy ${j.camera}. ${j.setting} ${loc.name} (${loc.description}), ${j.time_of_day}, ánh sáng: ${loc.lighting}. Tâm trạng: ${j.mood}. Nhân vật: ${chars || 'không có'}. Hành động: ${j.action}`;\n  return { json: { shot_id: j.shot_id, slug: j.slug, version: j.version || 1, camera: j.camera, action: j.action, prompt, job: j } };\n});"
      },
      "id": "c0000005-0000-4000-8000-000000000005",
      "name": "Dựng prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "m1",
              "leftValue": "={{ $('Cấu hình').first().json.provider }}",
              "rightValue": "mock",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c0000006-0000-4000-8000-000000000006",
      "name": "Chọn nhà cung cấp ảnh",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst wrap = (text, n) => {\n  const lines = [];\n  let cur = '';\n  for (const w of String(text || '').split(' ')) {\n    if ((cur + ' ' + w).trim().length > n) { lines.push(cur); cur = w; }\n    else { cur = (cur + ' ' + w).trim(); }\n  }\n  if (cur) lines.push(cur);\n  return lines;\n};\nconst font = 'Helvetica, Arial, sans-serif';\nreturn $input.all().map(item => {\n  const j = item.json;\n  const lines = wrap(j.action, 46).slice(0, 6);\n  const body = lines.map((l, i) => `<text x=\"80\" y=\"${300 + i * 48}\" font-size=\"34\" fill=\"#ffffff\" font-family=\"${font}\">${esc(l)}</text>`).join('');\n  const shift = ((Number(j.version) || 1) - 1) * 40;\n  const svg = `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1280\" height=\"720\" viewBox=\"0 0 1280 720\"><defs><linearGradient id=\"g\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\" gradientTransform=\"rotate(${shift} .5 .5)\"><stop offset=\"0\" stop-color=\"#ff8a3d\"/><stop offset=\"0.5\" stop-color=\"#ff4f9a\"/><stop offset=\"1\" stop-color=\"#7a4dff\"/></linearGradient></defs><rect width=\"1280\" height=\"720\" fill=\"url(#g)\"/><text x=\"80\" y=\"120\" font-size=\"56\" font-weight=\"700\" fill=\"#ffffff\" font-family=\"${font}\">${esc(j.slug)} · ${esc(j.camera)} · v${esc(j.version)}</text><text x=\"80\" y=\"190\" font-size=\"28\" fill=\"#ffffff\" fill-opacity=\"0.8\" font-family=\"${font}\">KEYFRAME MOCK</text>${body}</svg>`;\n  const url = 'data:image/svg+xml;base64,' + Buffer.from(svg).toString('base64');\n  return { json: { sid: j.shot_id, prompt: j.prompt, url } };\n});"
      },
      "id": "c0000007-0000-4000-8000-000000000007",
      "name": "Vẽ ảnh mock",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        -220
