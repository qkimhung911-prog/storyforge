    },
    {
      "parameters": {
        "jsCode": "const parts = $input.first().json.candidates[0].content.parts;\nconst text = parts.map(p => p.text || '').join('');\nlet map;\ntry { map = JSON.parse(text); } catch (e) { throw new Error('Gemini trả về JSON không hợp lệ: ' + text.slice(0, 300)); }\nreturn $('Dựng prompt').all().map(s => {\n  const en = map[s.json.slug];\n  if (!en) throw new Error('Gemini không dịch shot ' + s.json.slug);\n  return { json: { shot_id: s.json.shot_id, slug: s.json.slug, version: s.json.version, prompt: String(en) } };\n});"
      },
