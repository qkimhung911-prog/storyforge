    {
      "parameters": {
        "method": "POST",
        "url": "=https://dlmboivixwjpjlmzfvuz.supabase.co/rest/v1/rpc/set_keyframe",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ sid: $json.sid, prompt: $json.prompt, url: $json.url }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "c0000008-0000-4000-8000-000000000008",
      "name": "Lưu keyframe mock",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        -220
      ]
    },
    {
      "parameters": {
        "jsCode": "const SYSTEM = \"You write prompts for a text-to-image model (FLUX). The user message is a JSON array of film shots, each with camera, setting, time of day, mood, location, characters (with their exact appearance) and action. For every shot write ONE English prompt of 60 to 90 words describing a photorealistic cinematic film still of that moment. Rules: describe every character that appears using the same wording in every shot (age, gender, Vietnamese ethnicity, hair, glasses, outfit, accessories); describe the location and its lighting; use the camera framing (wide, medium, close-up, insert, two-shot); describe the action; keep the main subject centered so a 16:9 crop works; no text, captions, logos, signs or watermarks anywhere in the image. End each prompt with: photorealistic, 35mm film, natural skin texture, soft film grain. Reply with ONLY a JSON object that maps each shot slug to its prompt.\";\nconst shots = $input.all().map(i => {\n  const j = i.json.job;\n  return { slug: j.slug, camera: j.camera, setting: j.setting, time_of_day: j.time_of_day, mood: j.mood,\n           location: j.location, characters: j.characters, action: j.action };\n});\nreturn [{ json: { body: {\n  system_instruction: { parts: [{ text: SYSTEM }] },\n  contents: [{ role: 'user', parts: [{ text: JSON.stringify(shots) }] }],\n  generationConfig: { responseMimeType: 'application/json', temperature: 0.3 },\n} } }];"
      },
      "id": "c0000009-0000-4000-8000-000000000009",
      "name": "Gom để dịch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        160
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{ $('Cấu hình').first().json.model_id }}:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "c0000010-0000-4000-8000-000000000010",
      "name": "Dịch sang tiếng Anh",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        160
