{
  "name": "StoryForge 03 - Render video",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "storyforge-render",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "c1111111-1111-4111-8111-111111111111",
      "name": "Nhận project",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "d2222222-2222-4222-8222-222222222222"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://dlmboivixwjpjlmzfvuz.supabase.co/rest/v1/rpc/get_render_job",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ pid: $('Nhận project').first().json.body.project_id }) }}",
        "options": {}
      },
      "id": "c3333333-3333-4333-8333-333333333333",
      "name": "Lấy danh sách shot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const shots = $input.all().map(i => i.json).filter(s => s && s.url);\nreturn [{ json: { shots } }];"
      },
      "id": "c4444444-4444-4444-8444-444444444444",
      "name": "Gom shot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://render:8000/render",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ project_id: $('Nhận project').first().json.body.project_id, shots: $json.shots }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "c5555555-5555-4555-8555-555555555555",
      "name": "Gọi render",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://dlmboivixwjpjlmzfvuz.supabase.co/rest/v1/rpc/set_video",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ pid: $('Nhận project').first().json.body.project_id, path: $json.file }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "c6666666-6666-4666-8666-666666666666",
      "name": "Lưu video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { project_id: $('Nhận project').first().json.body.project_id, video: $('Gọi render').first().json.file, shots: $('Gọi render').first().json.shots, size_bytes: $('Gọi render').first().json.size_bytes } }}",
        "options": {}
      },
      "id": "c7777777-7777-4777-8777-777777777777",
      "name": "Trả kết quả",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1100,
        0
      ]
    }
