      "parameters": {
        "method": "POST",
        "url": "https://dlmboivixwjpjlmzfvuz.supabase.co/rest/v1/rpc/get_dialogue_jobs",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ pid: $('Nhận project').first().json.body.project_id }) }}",
        "options": {}
      },
      "id": "e3333333-3333-4333-8333-333333333333",
      "name": "Lấy câu thoại",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Chọn giọng theo giới tính nhân vật, phong cách nói lấy từ cột voice của Asset Bible.\nconst VOICES = { male: 'Charon', female: 'Leda' };\nreturn $input.all().filter(i => i.json && i.json.line).map(item => {\n  const j = item.json;\n  const gender = String(j.gender || '').toLowerCase();\n  const voice = gender.startsWith('nam') ? VOICES.male : VOICES.female;\n  const style = String(j.voice || 'tự nhiên').toLowerCase();\n  const name = `${j.shot_slug}-${j.idx}`;\n  const request = {\n    model: 'gemini-3.8-flash-tts',\n    input: [{ type: 'user_input', content: [{ type: 'text', text: j.line,\n      annotations: [{ type: 'speech_metadata', style }] }] }],\n    response_format: { type: 'audio' },\n    generation_config: { speech_config: [{ voice }] },\n  };\n  return { json: { name, shot_slug: j.shot_slug, character: j.name, voice, line: j.line, request } };\n});"
      },
      "id": "e4444444-4444-4444-8444-444444444444",
      "name": "Chọn giọng",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/interactions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.request) }}",
        "options": {
          "timeout": 120000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 3000
            }
          }
        }
      },
      "id": "e5555555-5555-4555-8555-555555555555",
      "name": "Gemini TTS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const jobs = $('Chọn giọng').all();\nreturn $input.all().map((item, i) => {\n  let data = null;\n  for (const step of (item.json.steps || [])) {\n    if (step.type !== 'model_output') continue;\n    for (const c of (step.content || [])) { if (c.type === 'audio') data = c.data; }\n  }\n  const job = jobs[i].json;\n  if (!data) throw new Error(`Không thấy audio cho ${job.name}: ` + JSON.stringify(item.json).slice(0, 300));\n  return { json: { name: job.name, data } };\n});"
      },
      "id": "e6666666-6666-4666-8666-666666666666",
      "name": "Lấy audio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://render:8000/audio",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ project_id: $('Nhận project').first().json.body.project_id, name: $json.name, data: $json.data }) }}",
        "options": {}
      },
      "id": "e7777777-7777-4777-8777-777777777777",
      "name": "Lưu file thoại",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const jobs = $('Chọn giọng').all();\nconst files = $input.all().map((item, i) => ({\n  name: jobs[i].json.name, character: jobs[i].json.character, voice: jobs[i].json.voice,\n  line: jobs[i].json.line, file: item.json.file, size_bytes: item.json.size_bytes,\n}));\nreturn [{ json: { project_id: $('Nhận project').first().json.body.project_id, count: files.length, files } }];"
      },
      "id": "e8888888-8888-4888-8888-888888888888",
      "name": "Tóm tắt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
