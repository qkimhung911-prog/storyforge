      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const provider = $('Cấu hình').first().json.provider;\nreturn $input.all().map(item => {\n  const j = item.json;\n  const loc = j.location || {};\n  const chars = (j.characters || []).map(c => {\n    const acc = (c.accessories || []).join(', ');\n    return `${c.name} (${c.gender}, ${c.age} tuổi, ${c.appearance}, ${c.outfit}${acc ? ', ' + acc : ''})`;\n  }).join('; ');\n  const prompt = `Góc máy ${j.camera}. ${j.setting} ${loc.name} (${loc.description}), ${j.time_of_day}, ánh sáng: ${loc.lighting}. Tâm trạng: ${j.mood}. Nhân vật: ${chars || 'không có'}. Hành động: ${j.action}`;\n  return { json: { shot_id: j.shot_id, slug: j.slug, camera: j.camera, action: j.action, prompt, provider } };\n});"
      },
      "id": "b5555555-5555-4555-8555-555555555555",
      "name": "Dựng prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "e1",
              "leftValue": "={{ $json.provider }}",
              "rightValue": "mock",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b6666666-6666-4666-8666-666666666666",
      "name": "Chọn nhà cung cấp ảnh",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst wrap = (text, n) => {\n  const lines = [];\n  let cur = '';\n  for (const w of String(text || '').split(' ')) {\n    if ((cur + ' ' + w).trim().length > n) { lines.push(cur); cur = w; }\n    else { cur = (cur + ' ' + w).trim(); }\n  }\n  if (cur) lines.push(cur);\n  return lines;\n};\nconst font = 'Helvetica, Arial, sans-serif';\nreturn $input.all().map(item => {\n  const j = item.json;\n  const lines = wrap(j.action, 46).slice(0, 6);\n  const body = lines.map((l, i) => `<text x=\"80\" y=\"${300 + i * 48}\" font-size=\"34\" fill=\"#ffffff\" font-family=\"${font}\">${esc(l)}</text>`).join('');\n  const svg = `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1280\" height=\"720\" viewBox=\"0 0 1280 720\"><defs><linearGradient id=\"g\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"#ff8a3d\"/><stop offset=\"0.5\" stop-color=\"#ff4f9a\"/><stop offset=\"1\" stop-color=\"#7a4dff\"/></linearGradient></defs><rect width=\"1280\" height=\"720\" fill=\"url(#g)\"/><text x=\"80\" y=\"120\" font-size=\"56\" font-weight=\"700\" fill=\"#ffffff\" font-family=\"${font}\">${esc(j.slug)} · ${esc(j.camera)}</text><text x=\"80\" y=\"190\" font-size=\"28\" fill=\"#ffffff\" fill-opacity=\"0.8\" font-family=\"${font}\">KEYFRAME MOCK</text>${body}</svg>`;\n  const url = 'data:image/svg+xml;base64,' + Buffer.from(svg).toString('base64');\n  return { json: { shot_id: j.shot_id, slug: j.slug, camera: j.camera, prompt: j.prompt, url } };\n});"
      },
      "id": "b7777777-7777-4777-8777-777777777777",
