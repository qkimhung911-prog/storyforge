      },
      "id": "d0000001-0000-4000-8000-000000000001",
      "name": "Nhận project",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "d0000002-0000-4000-8000-000000000002"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "p1",
              "name": "account_id",
              "value": "THAY-ACCOUNT-ID-O-DAY",
