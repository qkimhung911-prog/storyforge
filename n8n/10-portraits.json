        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ cid: $json.cid, url: $json.url }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "d0000012-0000-4000-8000-000000000012",
      "name": "Lưu chân dung",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const jobs = $('Ghép prompt').all();\nreturn [{ json: {\n  project_id: $('Nhận project').first().json.body.project_id,\n  count: jobs.length,\n  characters: jobs.map(j => j.json.slug),\n} }];"
      },
      "id": "d0000013-0000-4000-8000-000000000013",
      "name": "Tóm tắt",
