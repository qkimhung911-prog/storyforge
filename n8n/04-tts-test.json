{
  "name": "StoryForge 04 - TTS thử",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "storyforge-tts-test",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "d1111111-1111-4111-8111-111111111111",
      "name": "Nhận yêu cầu",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "e2222222-2222-4222-8222-222222222222"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/interactions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gemini-3.8-flash-tts', input: [{ type: 'user_input', content: [{ type: 'text', text: 'Anh chờ em từ lúc trời bắt đầu mưa.', annotations: [{ type: 'speech_metadata', style: 'giọng trầm, nói chậm, ấm áp, hoài niệm' }] }] }], response_format: { type: 'audio' }, generation_config: { speech_config: [{ voice: 'Charon' }] } }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "d3333333-3333-4333-8333-333333333333",
      "name": "Gemini TTS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "let data = null;\nfor (const step of ($json.steps || [])) {\n  if (step.type !== 'model_output') continue;\n  for (const c of (step.content || [])) {\n    if (c.type === 'audio') data = c.data;\n  }\n}\nif (!data) throw new Error('Không thấy audio trong phản hồi Gemini: ' + JSON.stringify($json).slice(0, 400));\nreturn [{ json: { data } }];"
      },
      "id": "d4444444-4444-4444-8444-444444444444",
      "name": "Lấy audio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://render:8000/audio",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ project_id: $('Nhận yêu cầu').first().json.body.project_id, name: 'tts-thu', data: $json.data }) }}",
        "options": {}
      },
      "id": "d5555555-5555-4555-8555-555555555555",
      "name": "Lưu file thoại",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": {}
      },
      "id": "d6666666-6666-4666-8666-666666666666",
      "name": "Trả kết quả",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        0
      ]
    }
  ],
  "connections": {
    "Nhận yêu cầu": {
      "main": [
        [
          {
            "node": "Gemini TTS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini TTS": {
      "main": [
        [
          {
            "node": "Lấy audio",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lấy audio": {
